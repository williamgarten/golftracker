# Postgres connection
DATABASE_URL=postgres://golftracker:golftracker@localhost:5432/golftracker

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=3000
NODE_ENV=development

# Set to "true" behind HTTPS (Fly.io) so the auth cookie gets Secure
COOKIE_SECURE=false
